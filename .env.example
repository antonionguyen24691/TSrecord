# API keys are entered in the in-app Settings screen and stored on-device.
# Keep real .env files local only; never commit secrets.

VITE_GEMINI_API_KEY=
VITE_ASSEMBLYAI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENAI_API_KEY=

# Public website URL used for canonical links and structured data.
VITE_SITE_URL=https://tsrecord.vn

# Separate backend deployment. Do not place backend source in this frontend deployment.
VITE_BACKEND_URL=https://api.tsrecord.vn

# Optional crash monitoring (leave empty to disable locally).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=1.4.6
