PORT=4000

# Optional crash monitoring (leave empty to disable locally).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional Slack/Discord webhook for HTTP 5xx alerts.
ALERT_WEBHOOK_URL=

# Chunked media upload sessions (proxy transcribe).
UPLOAD_SESSION_MAX_BYTES=26214400
UPLOAD_SESSION_TTL_MINUTES=30
APP_VERSION=1.4.6

# Comma-separated browser origins allowed to call the API.
# Local dev allows all origins when unset and NODE_ENV != production.
# Include admin panel port 4000 when serving from the same backend.
CORS_ALLOWED_ORIGINS=https://tsrecord.vn,https://www.tsrecord.vn,http://localhost:3000,http://localhost:4000,http://127.0.0.1:4000

# Rate limiting (per IP). Uses Upstash Redis when configured, else in-memory.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_PROXY_MAX=20
RATE_LIMIT_WEBHOOK_MAX=300
# RATE_LIMIT_DISABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Play Integrity (Android device attestation).
GOOGLE_PLAY_PACKAGE_NAME=com.trichxuatamthanh.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_NUMBER=
# PLAY_INTEGRITY_REQUIRED=true

# E-invoice provider slots (optional — cũng cấu hình được qua Admin UI).
# Provider mặc định: internal (hóa đơn HTML thông thường).
VIETTEL_EINVOICE_API_URL=
VIETTEL_EINVOICE_USERNAME=
VIETTEL_EINVOICE_PASSWORD=
MISA_EINVOICE_API_URL=
MISA_EINVOICE_APP_ID=
MISA_EINVOICE_TAX_CODE=
MISA_EINVOICE_ACCESS_TOKEN=

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# PostgreSQL serverless database used by /api/v2.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Protects /api/v2/admin/*.
ADMIN_API_KEY=replace-with-a-long-random-api-key

# Device JWT for /api/client/* (falls back to JWT_SECRET).
DEVICE_AUTH_SECRET=
DEVICE_AUTH_TTL=30d

# PostgreSQL TLS verification (set false only for local dev DB).
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Public app URL used by Stripe Checkout redirects.
PUBLIC_APP_URL=https://your-app.example

# SePay bank transfer / VietQR.
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_HMAC_SECRET=

# Stripe international payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# System keys for /api/client proxy on PostgreSQL (replaces SQLite system_config).
ADMIN_GEMINI_API_KEY=
ADMIN_GROQ_API_KEY=
ADMIN_OPENAI_API_KEY=
ADMIN_ASSEMBLYAI_API_KEY=
SYSTEM_GOOGLE_CLIENT_ID=
SYSTEM_GOOGLE_API_KEY=
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_REWARDED_ID=
