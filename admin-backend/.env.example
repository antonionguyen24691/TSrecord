PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# PostgreSQL serverless database used by /api/v2.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Protects /api/v2/admin/*.
ADMIN_API_KEY=replace-with-a-long-random-api-key

# Public app URL used by Stripe Checkout redirects.
PUBLIC_APP_URL=https://your-app.example

# SePay bank transfer / VietQR.
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_HMAC_SECRET=

# Stripe international payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
